    {
      "parameters": {
        "jsCode": "const payload = $('Normalize Payload').first().json;\nconst found = $input.all().filter(i => i.json && i.json.sessionId);\n\nif (found.length > 0) {\n  return [{ json: { duplicate: true, sessionId: payload.sessionId } }];\n}\n\nconst message = `🔥 Streak now ${payload.streak} days, +${payload.coins} coins`;\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    duplicate: false,\n    sessionId: payload.sessionId,\n    studentId: payload.studentId,\n    coins: payload.coins,\n    streak: payload.streak,\n    message,\n    sentAt: now,\n    createdAt: now\n  }\n}];"
      },
      "id": "a5-dedup",
      "name": "Dedup Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200]
    },
